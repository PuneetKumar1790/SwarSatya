{
  "manifest_version": 3,
  "name": "SwarSatya - Real-Time AI Voice Impersonation Guard",
  "version": "1.0.0",
  "description": "Real-time AI voice cloning and impersonation defense guard for browser calls (Google Meet, Microsoft Teams, WhatsApp Web).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SwarSatya Voice Guard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabCapture",
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "ws://127.0.0.1:8000/*",
    "ws://localhost:8000/*"
  ]
}
